# --- Database (Postgres) -------------------------------------------------
# For local development this points at a Postgres on localhost.
# With Docker Compose, docker-compose.yml builds DATABASE_URL itself from
# POSTGRES_PASSWORD, so this value is ignored there.
DATABASE_URL="postgresql://meme:dev-only-password@localhost:5432/meme_battle?schema=public"

# Password for the bundled Postgres (Docker Compose only). REQUIRED before the
# first start: Postgres only applies it when the pgdata volume is initialized.
# Changing it later requires recreating the database volume (or ALTER ROLE).
# Use letters/digits: the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# --- Server ---------------------------------------------------------------
# Port the app listens on (inside the container; always 3000 with Docker).
PORT=3000
# Host interface and port the Docker Compose setup publishes the app on.
# 0.0.0.0 is required for phones on the same LAN; use 127.0.0.1 for local-only.
APP_BIND=0.0.0.0
APP_PORT=3000
# Optional: run a published image instead of building locally, e.g.
# APP_IMAGE=ghcr.io/nschmidtdev/memebattle:latest
# APP_IMAGE=meme-battle-app:local
# The all-in-one Compose file (docker-compose.bundled.yml) uses its own image
# and needs neither POSTGRES_PASSWORD nor DATABASE_URL:
# BUNDLED_IMAGE=ghcr.io/nschmidtdev/memebattle:latest-bundled

# Comma-separated extra allowed Socket.io origins, e.g.
# CORS_ORIGIN="https://memes.example.com,http://192.168.1.10:3000"
# Same-origin is always allowed. Unset/empty = same-origin only. Use "*" to
# allow every origin (e.g. a separately hosted client).
# CORS_ORIGIN=""

# --- Admin -----------------------------------------------------------------
# The admin user is created on first boot if it does not exist yet.
ADMIN_EMAIL="admin@localhost"
# Leave empty/unset to auto-generate a one-time password (printed to the server
# log on first boot). If set, it is applied to the admin user on every boot.
# ADMIN_PASSWORD="change-me"
# Mark the admin session cookie Secure. Leave unset to auto-detect HTTPS from
# X-Forwarded-Proto (reverse proxy) or the request URL. Set "true"/"false" to
# force it.
# COOKIE_SECURE=true

# --- Seed / storage ---------------------------------------------------------
# Seed on container start (idempotent). Set to "false" to skip entirely.
SEED_ON_BOOT=true
# Only for a deliberate re-sync of the seeded Classic pack from an attached
# shell, e.g. `docker compose exec -e SEED_FORCE=1 app npx tsx prisma/seed.ts`.
# SEED_FORCE=1

# Directory for uploaded meme template images (Docker: /data/uploads).
UPLOAD_DIR="./data/uploads"
