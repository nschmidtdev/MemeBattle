# --- Database (Postgres) -------------------------------------------------
# For the docker-compose setup this points at the bundled "db" service.
DATABASE_URL="postgresql://meme:secret@localhost:5432/meme_battle?schema=public"

# --- Server ---------------------------------------------------------------
# Port the app listens on.
PORT=3000
# Optional: allowed origin for socket.io (defaults to same-origin, "*" for dev).
# CORS_ORIGIN="*"

# --- Admin -----------------------------------------------------------------
# The admin user is created on first boot if it does not exist yet.
ADMIN_EMAIL="admin@localhost"
# Leave unset to auto-generate a one-time password (printed to the server log).
# ADMIN_PASSWORD="change-me"

# --- Storage ----------------------------------------------------------------
# Directory for uploaded meme template images (Docker: /data/uploads).
UPLOAD_DIR="./data/uploads"
