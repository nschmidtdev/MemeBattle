{
  "name": "meme-battle",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Self-hosted, open-source multiplayer meme party game: caption templates, vote, win.",
  "author": "nschmidtdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nschmidtdev/MemeBattle.git"
  },
  "homepage": "https://github.com/nschmidtdev/MemeBattle#readme",
  "bugs": {
    "url": "https://github.com/nschmidtdev/MemeBattle/issues"
  },
  "keywords": [
    "meme",
    "party-game",
    "self-hosted",
    "multiplayer",
    "nextjs",
    "socket-io",
    "postgresql",
    "docker"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx scripts/start.mjs",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "uploads:cleanup": "tsx scripts/cleanup-uploads.ts",
    "import:pack": "tsx scripts/import-pack.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e.ts",
    "lint": "eslint ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "next": "^15.4.0",
    "prisma": "^6.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
